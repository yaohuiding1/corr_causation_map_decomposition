\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {A schematic of the generative model in spectral dynamic causal modeling in \cite  {Friston2014}}. We use four default-mode regions (mPFC, PCC, L-IPC, and R-IPC) to illustrate a directed network. Thicker arrows indicate stronger causal influences. The matrix panels contrast a nondiagonal spatial covariance factor, asymmetric causal connectivity, and symmetric covariance. Colored bars identify regions. All parameter values are picked illustrative purposes. The observation mapping is set to the identity matrix. Neuronal noise has unit amplitude, unit marginal spatial variance, and a power-law exponent of 0.5, and observation noise is set to zero.}}{3}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:spectral_dcm_schematic}{{1}{3}{\textbf {A schematic of the generative model in spectral dynamic causal modeling in \cite {Friston2014}}. We use four default-mode regions (mPFC, PCC, L-IPC, and R-IPC) to illustrate a directed network. Thicker arrows indicate stronger causal influences. The matrix panels contrast a nondiagonal spatial covariance factor, asymmetric causal connectivity, and symmetric covariance. Colored bars identify regions. All parameter values are picked illustrative purposes. The observation mapping is set to the identity matrix. Neuronal noise has unit amplitude, unit marginal spatial variance, and a power-law exponent of 0.5, and observation noise is set to zero}{figure.caption.6}{}}
